{
  "name": "boarddd",
  "version": "0.3.0",
  "description": "PCB rendering for the browser: 2D Gerber/Excellon rendering (wasm), board solids from Gerber/Excellon, KiCad footprints, GLB/STEP models, a small three.js viewer.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoolNamesAllTaken/boarddd.git"
  },
  "exports": {
    "./geom": {
      "types": "./src/geom/index.d.ts",
      "default": "./src/geom/index.js"
    },
    "./board": {
      "types": "./src/board/index.d.ts",
      "default": "./src/board/index.js"
    },
    "./footprint": {
      "types": "./src/footprint/index.d.ts",
      "default": "./src/footprint/index.js"
    },
    "./models": {
      "types": "./src/models/index.d.ts",
      "default": "./src/models/index.js"
    },
    "./scene": {
      "types": "./src/scene/index.d.ts",
      "default": "./src/scene/index.js"
    },
    "./gerber": {
      "types": "./src/gerber/index.d.ts",
      "default": "./src/gerber/index.js"
    },
    "./gerber/contour-worker.js": "./src/gerber/contour-worker.js",
    "./view2d": {
      "types": "./src/view2d/index.d.ts",
      "default": "./src/view2d/index.js"
    },
    "./model": {
      "types": "./src/model/index.d.ts",
      "default": "./src/model/index.js"
    },
    "./impedance": {
      "types": "./src/impedance/index.d.ts",
      "default": "./src/impedance/index.js"
    },
    "./schema/board.schema.json": "./schema/board.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schema",
    "third_party/wasm-gerber-renderer/core",
    "third_party/wasm-gerber-renderer/odb",
    "third_party/wasm-gerber-renderer/LICENSE",
    "third_party/wasm-gerber-renderer/README.md",
    "third_party/wasm-gerber-renderer/FORK_COMMIT",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit --lib es2022,dom --moduleResolution bundler --module esnext src/geom/index.d.ts src/board/index.d.ts src/footprint/index.d.ts src/models/index.d.ts src/scene/index.d.ts src/model/index.d.ts src/gerber/index.d.ts src/view2d/index.d.ts src/impedance/index.d.ts && tsc -p test/types/tsconfig.json",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm": "bash scripts/build-wasm.sh --check"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/three": "^0.185.0",
    "esbuild": "0.28.2",
    "occt-import-js": "0.0.23",
    "three": "0.185.0",
    "typescript": "^5.9.3"
  }
}
