(footprint "Pad_Shapes_boarddd"
	(version 20241229)
	(generator "boarddd")
	(layer "F.Cu")
	(descr "one pad of each KiCad pad shape, some rotated and offset, for test/geom/pads.test.mjs")
	(pad "1" smd rect (at 0 0) (size 2 1) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd roundrect (at 4 0 30) (size 2 1) (roundrect_rratio 0.25) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "3" smd oval (at 8 0 90) (size 3 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "4" smd circle (at 12 0) (size 1.5 1.5) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "5" smd trapezoid (at 0 4) (size 2 1) (rect_delta 0.4 0) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "6" smd trapezoid (at 4 4 45) (size 2 1) (rect_delta 0 0.6) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "7" smd roundrect (at 8 4) (size 2 1.4) (roundrect_rratio 0.25) (chamfer_ratio 0.3) (chamfer top_left bottom_right) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "8" smd roundrect (at 12 4 -60) (size 2 1.4) (roundrect_rratio 0) (chamfer_ratio 0.2) (chamfer top_right bottom_left) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "9" thru_hole oval (at 0 8 120) (size 3 1.6) (drill oval 2 0.8 (offset 0.3 0)) (layers "*.Cu" "*.Mask"))
	(pad "10" thru_hole rect (at 4 8 15) (size 1.7 1.7) (drill 1 (offset 0 -0.2)) (layers "*.Cu" "*.Mask"))
	(pad "11" smd custom (at 8 8 90) (size 1 1) (layers "F.Cu" "F.Mask")
		(options (clearance outline) (anchor rect))
		(primitives (gr_poly (pts (xy 0 -0.5) (xy 1.5 -0.5) (xy 1.5 1.2) (xy 0 0.5)) (width 0) (fill yes))))
	(pad "12" smd custom (at 12 8) (size 0.8 0.8) (layers "F.Cu" "F.Mask")
		(options (clearance outline) (anchor circle))
		(primitives (gr_line (start 0 0) (end 1.5 0) (width 0.4))))
)
